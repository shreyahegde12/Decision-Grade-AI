HOST=127.0.0.1
PORT=4318
NODE_ENV=development
TRUSTGATE_TOKEN=replace-with-at-least-32-random-characters
TRUSTGATE_REVIEWER_TOKEN=replace-with-a-different-32-character-token
TRUSTGATE_REVIEWER_ID=security-reviewer
TRUSTGATE_DB=./data/trustgate.sqlite
HR_API_KEY=
HR_HARNESS_ID=
